# Keep false in development, CI, and shared previews.
# Set true only in a reviewed HTTPS deployment after exact-origin CORS,
# CSP/connect-src, and owner-controlled least-privilege read checks pass.
VITE_ENABLE_ACCOUNT_READS=false

# Existing public backend facade setting; do not use it for private account data.
# VITE_API_BASE=https://your-public-worker.example
