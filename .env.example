# Polyap — server-side / deployment environment variables (reference only).
# Copy what you need into your host's settings (wrangler secrets/vars, Vercel
# env, or a local .env). Never commit real values. See docs/DEPLOYMENT.md.

# --- Public data (MCP) ---------------------------------------------------
# Primary MCP endpoint override. Blank counts as unset. Defaults to testnet.
# MCP_URL=https://polyester-mcp-testnet.fabriclabs.workers.dev/mcp
# Used only when MCP_URL is unset/blank (for a future public mainnet endpoint).
# MCP_URL_MAINNET=

# --- Wallet sign-in proxy ------------------------------------------------
# Comma-separated exact origins allowed to call /api/auth/* cross-origin.
# Empty = same-origin only (right for Cloudflare Pages Functions).
# POLYAP_APP_ORIGINS=https://your-frontend.example
# Legacy name, still read when POLYAP_APP_ORIGINS is unset or blank:
# POLYTOOLS_APP_ORIGINS=
# Upstream Polyester API origin (must be *.polyester.com, or loopback in dev).
# POLYESTER_API_ORIGIN=https://api.testnet.polyester.com

# --- Optional Telegram alert bot (root/standalone Worker cron) -----------
# Set these as secrets (npx wrangler secret put ...), never in a file.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_MIN_BPS=300

# --- Owner-only live verification (scripts/live-test.mjs) ---------------
# Never in CI. Requires PUBLIC_KEY, PRIVATE_KEY, KEY_ID in a gitignored .env.
# POLYAP_LIVE_TEST=1
# Legacy name, still accepted when POLYAP_LIVE_TEST is unset or blank:
# POLYTOOLS_LIVE_TEST=1
